# Backend HTTP port. Defaults to 3001 if omitted.
PORT=3001

# Supabase HTTPS Data API credentials (backend only; never expose the service role key to a browser).
# Find the project URL and service role key in Supabase project settings/API keys.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# GitHub OAuth App (needed for account sign-in and private repository imports).
# Homepage URL: http://localhost:5173
# Authorization callback URL: http://localhost:3001/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback
FRONTEND_URL=http://localhost:5173

# GitHub push webhook verification. Configure the same random secret in the
# GitHub webhook settings. GITHUB_SCAN_TOKEN is optional and is used only by
# the backend when an accepted push needs to clone a private repository.
GITHUB_WEBHOOK_SECRET=
GITHUB_SCAN_TOKEN=

# Optional root containing local repositories that may be imported through the
# dashboard. Paths outside this directory are rejected.
LOCAL_REPOSITORY_ROOT=C:\Projects
